# ===========================================
# Colombian Recipe API - Environment Variables
# ===========================================
# Copy this file to .env: cp .env.example .env

# ─────────────────────────────────────────────
# FLASK CONFIGURATION
# ─────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-super-secret-key-change-in-production

# ─────────────────────────────────────────────
# JWT CONFIGURATION
# ─────────────────────────────────────────────
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=86400

# ─────────────────────────────────────────────
# DATABASE CONFIGURATION (MySQL)
# ─────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://root:password@db:3306/colombian_recipes
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=colombian_recipes

# ─────────────────────────────────────────────
# AI PROVIDERS (Add your API keys)
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# ─────────────────────────────────────────────
# CORS (Frontend URLs)
# ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000